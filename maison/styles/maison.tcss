/* ═══════════════════════════════════════════════════════════════════════
   FOOTER - the same under every tab: a rule, then Exit and Help
   ═══════════════════════════════════════════════════════════════════════ */

#app-footer {
    dock: bottom;
    height: auto;
}

#app-footer-bar {
    height: auto;
    padding: 0 1;
    border-top: solid $gutter;
}

/* Neutral, like the Close button on tui-kit's panels; Exit is tinted red. Help on the right */
#btn-help {
    dock: right;
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0;
    border: none;
    padding: 0 2;
    background: $bg-light;
    color: $fg;
}

#btn-help:hover {
    background: $gutter;
}

/* A message in Help's place while one shows (FooterMessage), right-aligned over the room left of
   it, an error still on up to three lines */
FooterMessage {
    width: 1fr;
    margin-left: 2;
    padding: 0;
    text-align: right;
}

/* ═══════════════════════════════════════════════════════════════════════
   TABS - every tab's view, laid out the same way
   ═══════════════════════════════════════════════════════════════════════ */

/* On each tab's view (MaisonApp.compose); no room on top, since the tabs keep a blank row under them */
.mode {
    padding: 0 4 1 4;
}

/* ═══════════════════════════════════════════════════════════════════════
   HELP - the keys every tab shares on the left, the tab's own on the right
   ═══════════════════════════════════════════════════════════════════════ */

/* As wide as their longest line, but some width each, so a tab with no keys of its own does not
   get a narrow panel: General's own width */
MaisonHelpScreen .shortcuts-section {
    width: auto;
    min-width: 24;
}

MaisonHelpScreen #shortcuts-general {
    margin-right: 4;
}

/* ═══════════════════════════════════════════════════════════════════════
   MONEY - the dashboard lists the accounts; one opens on its own page
   ═══════════════════════════════════════════════════════════════════════ */

#money-pages,
#money-pages > *,
#accounts-scroll {
    height: 1fr;
}

/* "── Joint ────", over each owner's table, and "── Transactions ────" over an account's */
SectionTitle {
    color: $yellow;
    text-style: bold;
}

/* As tall as its labels and rows (AccountsTable sets the height), so the dashboard scrolls and never
   the table; a blank row before the next owner */
AccountsTable {
    max-height: 100vh;
    margin-bottom: 1;
    scrollbar-size-vertical: 0;
}

#account-table,
#returns-table {
    height: 1fr;
}

/* As flotte's: "Accounts" blue, on an account's page a link back before the account's name, in yellow */
#accounts-title,
#breadcrumbs,
.breadcrumbs {
    height: 1;
    margin-bottom: 1;
    padding: 0 1;
}

.breadcrumb-current {
    width: auto;
    color: $yellow;
    text-style: bold;
}

#accounts-title,
#breadcrumb-accounts,
#breadcrumb-todos {
    color: $blue;
}

#breadcrumb-accounts,
#breadcrumb-todos {
    width: auto;
}

#breadcrumb-accounts:hover,
#breadcrumb-todos:hover {
    text-style: underline;
}

#breadcrumb-separator,
.breadcrumb-separator {
    width: auto;
    margin: 0 1;
    color: $comment;
}

#breadcrumbs .spacer,
.breadcrumbs .spacer {
    width: 1fr;
}

/* The details on the left, the balance by them; a blank row under */
#account-header {
    height: auto;
    margin-bottom: 1;
}

#account-details,
#account-balance {
    width: auto;
    padding: 0 1;
}

#account-balance {
    margin-left: 6;
}

/* Under the header: the Transactions and Balances tabs, each filling the page's height */
#account-tabs,
#account-tabs TabPane,
#account-tabs ContentSwitcher {
    height: 1fr;
}

#account-tabs TabPane {
    padding: 0;
}

/* The balance chart, as tall as its tab, its axis and the years on its last two rows */
#balance-chart {
    height: 1fr;
    padding: 0 1;
}

MoneyTable {
    background: transparent;
    color: $fg;
}

#accounts-scroll,
MoneyTable {
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $comment;
}

MoneyTable > .datatable--header,
MoneyTable > .datatable--header-hover {
    background: transparent;
    color: $comment;
    text-style: none;
}

/* Shaded only in the table that has focus: the dashboard has one per owner */
MoneyTable > .datatable--cursor {
    background: transparent;
    color: $fg;
    text-style: none;
}

MoneyTable:focus > .datatable--cursor {
    background: $bg-light;
}

/* Never drawn: the cursor follows the pointer instead (MoneyTable) */
MoneyTable > .datatable--hover {
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════════════
   TODOS - as Travail's: the search, the status and New Todo over the count and the rows
   ═══════════════════════════════════════════════════════════════════════ */

#todo-controls {
    height: auto;
}

#todo-controls #search {
    width: 1fr;
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

#todo-controls #search:focus {
    border: solid $blue;
}

/* Boxed like the search next to it; its overlay opens below */
#todo-controls Select {
    width: 14;
    height: 3;
    margin: 0 0 0 2;
}

#todo-controls Select SelectCurrent {
    background: $bg;
    border: solid $gutter;
    padding: 0 1;
    color: $fg;
}

#todo-controls Select:focus SelectCurrent {
    border: solid $blue;
}

#todo-controls Select SelectOverlay {
    background: $bg-dark;
    border: none;
}

#todo-controls Select SelectOverlay > .option-list--option-highlighted {
    background: $bg-light;
    color: $fg;
    text-style: none;
}

/* The search box is 3 rows with its border; the top margin lines the button up with its text */
#todo-controls .tinted {
    margin: 1 0 0 3;
}

#todo-count {
    height: 1;
    padding: 0 1;
    color: $green;
}

#todo-rule {
    height: 1;
    color: $comment;
}

/* As Travail's: no header, the cursor's row shaded, the pointer moving it */
#todo-table {
    height: 1fr;
    background: transparent;
    color: $fg;
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $blue;
    overflow-x: hidden;
}

#todo-table > .datatable--cursor {
    background: transparent;
    color: auto;
    text-style: none;
}

#todo-table:focus > .datatable--cursor {
    background: $bg-light;
}

#todo-table > .datatable--hover {
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════════════
   FORMS - a transaction's modal form (.form-screen) and a todo's page, sharing the .form class
   ═══════════════════════════════════════════════════════════════════════ */

.form-screen {
    align: center top;
    background: $bg 80%;
}

/* As flotte's forms: grey labels, and fields with no box, only a line under them, blue when focused */
.form-screen > Vertical {
    width: 60;
    padding: 1 2;
}

.form #dialog-title {
    margin-bottom: 1;
}

.form .form-row {
    height: 2;
    align: left top;
    margin-bottom: 1;
}

/* tui-kit pads labels down to meet its boxed inputs; these fields have no top border */
.form .field-label {
    width: 14;
    padding: 0;
    color: $comment;
}

.form Input {
    width: 1fr;
    height: 2;
    padding: 0;
    background: transparent;
    border: none;
    border-bottom: solid $gutter;
}

.form Input:hover {
    border-bottom: solid $blue;
}

.form Input:focus {
    border: none;
    border-bottom: solid $blue;
    background: transparent;
}

/* Under the fields, each only when it has something to say, a blank row under it */
.form #transaction-preview,
.form #transaction-error {
    display: none;
    height: auto;
    margin-bottom: 1;
}

.form #transaction-error {
    color: $red;
}

/* The last field's blank row is the space over them */
.form #dialog-buttons {
    height: 1;
    margin-top: 0;
}

.form .tinted {
    margin: 0 0 0 1;
}

/* Between Delete, on the left, and Cancel and Save */
.form #dialog-buttons .spacer {
    width: 1fr;
}

.form #delete-btn {
    margin: 0;
}

/* A reminder: a number, its unit, "before", then Remove at the right */
.form .length-number {
    width: 6;
    margin-right: 2;
}

.form Select {
    width: 14;
    height: 2;
}

.form SelectCurrent {
    height: 2;
    padding: 0;
    background: transparent;
    border: none;
    border-bottom: solid $gutter;
}

.form Select:focus > SelectCurrent {
    border: none;
    border-bottom: solid $blue;
}

.form .length-after {
    width: 1fr;
    margin-left: 2;
    color: $comment;
}

/* The reminders, one row each, then Add reminder */
.form .reminders-row,
.form #reminders {
    height: auto;
}

.form .reminder-row {
    height: 2;
}

.form .remove-reminder {
    margin: 0 0 0 2;
}

.form #add-reminder {
    margin: 0 0 1 0;
}

.form #form-error {
    display: none;
    height: auto;
    margin-bottom: 1;
    color: $red;
}

/* A closed todo's day and outcome, in the reminders' place */
.form #closed-part {
    height: auto;
}

/* The todo form, kept short: no blank row between its fields, their lines under them set them apart */
.form.-compact .form-row {
    margin-bottom: 0;
}

/* ═══════════════════════════════════════════════════════════════════════
   A TODO'S PAGE - in the list's place, with room for notes on many lines
   ═══════════════════════════════════════════════════════════════════════ */

#todo-list,
#todo-page {
    height: 1fr;
}

/* A field of many lines, boxed: two lines of text, growing with what is written up to ten */
.form .text-row {
    height: auto;
    margin-bottom: 1;
}

.form TextArea {
    width: 1fr;
    height: auto;
    min-height: 4;
    max-height: 12;
    padding: 0 1;
    /* A color, not transparent: TextArea's theme needs one, else it falls back on one the app may not have */
    background: $bg;
    border: round $gutter;
}

.form TextArea:focus {
    border: round $blue;
}
